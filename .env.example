# ==============================================================================
# S.H.A.D.E. — ENVIRONMENT CONFIGURATION TEMPLATE
# Project: S.H.A.D.E. | Local-First, Privacy-First Architecture
# DO NOT COMMIT REAL SECRETS IN THIS FILE OR ANY .env FILE.
# ==============================================================================

# Application Environment
SHADE_ENV=development
SHADE_HOST=127.0.0.1
SHADE_PORT=8000
DEBUG=false

# Primary Local Encrypted Data Vault (Authoritative Store)
# S.H.A.D.E. stores all sensitive real data and synthetic mappings locally on the owner's device.
DATABASE_URL=sqlite+aiosqlite:///./data/shade_vault.db
DATABASE_ENCRYPTION_PROVIDER=sqlcipher
# Platform Key Storage: auto | dpapi (Windows) | keychain (macOS) | secret-service (Linux) | dev-passphrase
KEY_STORAGE_BACKEND=auto

# Cryptographic Master Encryption Key & JWT Signing
# 32-byte base64 key managed via SecureKeyStore platform abstraction
SHADE_MASTER_ENCRYPTION_KEY=replace_with_32_byte_base64_encryption_key_for_aes256_gcm==
SHADE_JWT_SECRET=replace_with_secure_random_jwt_secret_token_string_here
SHADE_JWT_ALGORITHM=HS256
SHADE_ACCESS_TOKEN_EXPIRE_MINUTES=15
SHADE_REFRESH_TOKEN_EXPIRE_DAYS=7

# Optional Ephemeral Security State (Rate Limiting / Replay Protection)
# When REDIS_URL is omitted or unreachable, S.H.A.D.E. automatically falls back to an in-memory sliding-window counter.
REDIS_URL=
RATE_LIMIT_PER_MINUTE=60

# External Intelligence APIs (Optional / Offline Resilient)
# External LLMs receive ONLY synthetic tokens (<SYN_AADHAAR_xxxx>). Real data never leaves the host.
# Leave empty to utilize local high-fidelity mock datasets for 100% offline demo resilience.
GEMINI_API_KEY=
HIBP_API_KEY=

# Optional Voice Module Parameters
PICOVOICE_ACCESS_KEY=
