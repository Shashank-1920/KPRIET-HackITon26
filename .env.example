# ==============================================================================
# S.H.A.D.E. — ENVIRONMENT CONFIGURATION TEMPLATE
# Project: S.H.A.D.E. | Repository: KPRIET-HackITon26
# DO NOT COMMIT REAL SECRETS IN THIS FILE OR ANY .env FILE.
# ==============================================================================

# Application Environment
SHADE_ENV=development
SHADE_HOST=127.0.0.1
SHADE_PORT=8000
DEBUG=false

# Security & Cryptography Secrets
# Generate 32 bytes using: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
SHADE_MASTER_ENCRYPTION_KEY=replace_with_32_byte_base64_encryption_key_for_aes256_gcm==
# Generate 32+ bytes for JWT HMAC signing
SHADE_JWT_SECRET=replace_with_secure_random_jwt_secret_token_string_here
SHADE_JWT_ALGORITHM=HS256
SHADE_ACCESS_TOKEN_EXPIRE_MINUTES=15
SHADE_REFRESH_TOKEN_EXPIRE_DAYS=7

# Primary Database Configuration (PostgreSQL 16)
# Local fallback: sqlite+aiosqlite:///./shade_local.db
DATABASE_URL=postgresql+asyncpg://shade_user:shade_password@localhost:5432/shade_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Cache / Ephemeral State (Redis 7)
# Local fallback: in-memory mock when Redis is unavailable
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=60

# External Intelligence APIs (Optional / Offline Resilient)
# Leave empty to utilize local high-fidelity mock datasets for offline demo resilience
GEMINI_API_KEY=
HIBP_API_KEY=

# Voice Module Parameters (Optional)
PICOVOICE_ACCESS_KEY=
